{
  "name": "online-quiz-battle-platform",
  "version": "1.0.0",
  "description": "Nền tảng Thi Trắc Nghiệm Trực Tuyến & Thi Đấu Thời Gian Thực (Online Quiz & Real-time Battle Platform)",
  "type": "module",
  "scripts": {
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
