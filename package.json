    "socket.io": "^4.8.1",
    "uuid": "^11.0.3",
    "xlsx": "^0.18.5"
  },
  "keywords": [
    "online-quiz",
    "realtime-battle",
    "socketio",
    "docx-parser",
    "proctoring",
    "react",
    "express",
    "vercel"
